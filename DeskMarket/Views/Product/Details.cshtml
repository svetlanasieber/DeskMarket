@model DeskMarket.Models.ProductDetailsViewModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Product Details";
}

<div class="d-flex justify-content-between align-items-center mb-3" style="margin-top: 20px;">
    <h2>@ViewData["Title"]</h2>
</div>
<hr />

<div class="row justify-content-center" style="margin: 0 auto; max-width: 800px;">
    <div class="col-md-4 text-center">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="img-fluid" style="max-width: 100%; height: auto;" alt="@Model.ProductName" />
        }
        else
        {
            <img src="~/img/no-image-available-02.jpg" class="img-fluid" style="max-width: 100%; height: auto;" alt="No Image Available" />
        }
    </div>

    <div class="col-md-8">
        <div class="card-body">
            <h5 class="card-title">@Model.ProductName</h5>
            <hr />
            <h6 class="card-subtitle mb-2 text-muted">@Model.Price.ToString("C")</h6>
            <hr />
            <p class="card-text">@Model.Description</p>
            <hr />
            <p class="card-text"><small class="text-muted">Category: @Model.CategoryName</small></p>
            <p class="card-text"><small class="text-muted">Added On: @Model.AddedOn / Seller: @Model.SellerName</small></p>
            <hr />            
        </div>
        
        <!-- Диагностична информация -->
        <div class="card-body text-start mb-2">
            <p>Автентикиран: @(User?.Identity?.IsAuthenticated == true ? "Да" : "Не")</p>
            @if (User?.Identity?.IsAuthenticated == true)
            {
                <p>Текущ потребител: @User.FindFirstValue(ClaimTypes.NameIdentifier)</p>
                <p>Продавач: @Model.SellerId</p>
                <p>Вие сте продавачът: @(Model.SellerId == User.FindFirstValue(ClaimTypes.NameIdentifier) ? "Да" : "Не")</p>
                <p>Продуктът е в количката: @(Model.IsInCart ? "Да" : "Не")</p>
            }
        </div>
        
        <div class="card-footer text-center">
            <div class="d-flex justify-content-between align-items-center">
                <a asp-controller="Product" asp-action="Index" class="btn btn-warning">Back</a>
                
                @if (User?.Identity?.IsAuthenticated == true)
                {
                    @if (Model.SellerId == User.FindFirstValue(ClaimTypes.NameIdentifier))
                    {
                        <a asp-controller="Product" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
                        <a asp-controller="Product" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
                    }
                    else if (!Model.IsInCart)
                    {
                        <a asp-controller="Product" asp-action="AddToCart" asp-route-id="@Model.Id" class="btn btn-success">Buy</a>
                    }
                    else
                    {
                        <span class="btn btn-secondary">Already in Cart</span>
                    }
                }
            </div>
        </div>
    </div>
</div>